{
  "buildCommand": "./node_modules/.bin/turbo run build --filter=docs",
  "outputDirectory": "apps/docs/storybook-static",
  "framework": null,
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "devCommand": "pnpm storybook:dev",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore.sh docs"
}
