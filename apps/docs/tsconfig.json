{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": false,
    "skipLibCheck": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "paths": {
      "@sorbet-ui/tokens": ["../../packages/tokens/src"],
      "@sorbet-ui/theme": ["../../packages/theme/src"],
      "@sorbet-ui/react": ["../../packages/react/src"]
    }
  },
  "include": [".storybook/**/*", "src/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
