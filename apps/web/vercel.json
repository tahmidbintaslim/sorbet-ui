{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web",
  "outputDirectory": "out",
  "cleanUrls": true,
  "ignoreCommand": "npx -y turbo-ignore@2.11.10 web --fallback=HEAD^"
}
