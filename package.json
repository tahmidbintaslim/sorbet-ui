{
  "name": "sorbet-ui",
  "version": "0.1.0",
  "description": "Sorbet UI: React components on Material UI v7 with one variant, color and size API.",
  "homepage": "https://github.com/tahmidbintaslim/sorbet-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahmidbintaslim/sorbet-ui.git"
  },
  "bugs": {
    "url": "https://github.com/tahmidbintaslim/sorbet-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "material-ui",
    "mui",
    "typescript",
    "dark-mode"
  ],
  "author": "Tahmid Bin Taslim Rafi (https://github.com/tahmidbintaslim)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "source-map-js@<1.2.2": "^1.2.2",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "glob@>=9.0.0 <=14.0.1": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:storybook": "pnpm --filter=docs exec vitest --project=storybook",
    "test:storybook:ci": "pnpm --filter=docs exec vitest run --project=storybook --browser.headless",
    "test:ci": "vitest run",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "check:all": "pnpm lint && pnpm type-check && pnpm test:ci",
    "dev": "turbo run dev --parallel",
    "web:build": "pnpm --filter=web build",
    "web:dev": "pnpm --filter=web dev",
    "storybook:build": "pnpm --filter=docs storybook:build",
    "storybook:dev": "pnpm --filter=docs storybook",
    "clean": "turbo run clean && rm -rf node_modules pnpm-lock.yaml",
    "web:e2e": "pnpm --filter=web test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-vitest": "^10.6.3",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.3",
    "tsup": "^8.5.1",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@sorbet-ui/core": "workspace:*",
    "@sorbet-ui/react": "workspace:*",
    "@sorbet-ui/theme": "workspace:*",
    "@sorbet-ui/tokens": "workspace:*"
  }
}
